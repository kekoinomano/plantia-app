{
  "expo": {
    "name": "saviasound",
    "slug": "saviasound",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saviasound",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.saviasound.app",
      "buildNumber": "2",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "saviasound necesita permiso para guardar tus vídeos en Fotos.",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#25382A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.saviasound.app",
      "versionCode": 2,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-android-dev-app",
      "expo-router",
      "expo-asset",
      "./plugins/with-video-storage",
      [
        "expo-camera",
        {
          "cameraPermission": "saviasound necesita la cámara para grabar vídeos con la señal de tu planta.",
          "microphonePermission": "saviasound incluye funciones de audio que pueden solicitar el micrófono para capturar sonido del dispositivo. La música de tu planta se genera con el sensor Bluetooth, sin usar el micrófono.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "react-native-zip-archive",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F1ECE3"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "saviasound utiliza Bluetooth para escuchar la señal de tu planta, también con la pantalla apagada."
        }
      ],
      "./plugins/with-background-playback",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": true,
          "androidForegroundService": true,
          "androidFSTypes": [
            "mediaPlayback",
            "connectedDevice"
          ],
          "androidPermissions": [
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.POST_NOTIFICATIONS"
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["es", "en"],
            "android": ["es", "en"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c3dbd3d-0825-4e94-8eda-b9f9ef65455f"
      }
    },
    "owner": "kekotron"
  }
}
